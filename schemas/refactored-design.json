{
  "database": "ecommerce_db_v2",
  "nosql_type": "Document-oriented (MongoDB) + Analytics Layer",
  "architecture": "Sharded Cluster with Replica Sets",
  
  "collections": {
    "users": {
      "description": "Profils utilisateurs shardés par région",
      "schema": {
        "_id": "ObjectId",
        "email": "string (unique)",
        "region": "string (shard key)",
        "name": {
          "first": "string",
          "last": "string"
        },
        "password_hash": "string",
        "addresses": [
          {
            "type": "string (billing/shipping)",
            "street": "string",
            "city": "string",
            "postal_code": "string",
            "country": "string",
            "is_default": "boolean"
          }
        ],
        "phone": "string",
        "created_at": "ISODate",
        "last_login": "ISODate",
        "preferences": "object",
        "loyalty_points": "integer",
        "total_orders": "integer (dénormalisé)",
        "total_spent": "decimal (dénormalisé)"
      },
      "sharding": {
        "shard_key": "region",
        "strategy": "Hashed sharding pour distribution uniforme",
        "zones": ["europe", "americas", "asia", "africa"]
      },
      "replication": {
        "replica_set_size": 3,
        "read_preference": "secondaryPreferred",
        "write_concern": "majority"
      },
      "indexes": [
        {"field": "email", "type": "unique"},
        {"field": "region", "type": "standard"},
        {"field": "created_at", "type": "standard"}
      ]
    },
    
    "products": {
      "description": "Catalogue produits avec données analytics intégrées",
      "schema": {
        "_id": "ObjectId",
        "sku": "string (shard key, unique)",
        "name": "string",
        "description": "string",
        "category_id": "ObjectId",
        "category_path": "string (dénormalisé)",
        "price": {
          "amount": "decimal",
          "currency": "string",
          "price_history": [
            {
              "amount": "decimal",
              "changed_at": "ISODate"
            }
          ]
        },
        "inventory": {
          "quantity": "integer",
          "warehouses": [
            {
              "location": "string",
              "quantity": "integer"
            }
          ]
        },
        "images": ["string"],
        "attributes": "object",
        "ratings": {
          "average": "number",
          "count": "integer",
          "distribution": {
            "5_star": "integer",
            "4_star": "integer",
            "3_star": "integer",
            "2_star": "integer",
            "1_star": "integer"
          }
        },
        "analytics": {
          "views_count": "integer",
          "purchases_count": "integer",
          "cart_adds_count": "integer",
          "conversion_rate": "number",
          "last_30_days_sales": "integer",
          "trending_score": "number"
        },
        "tags": ["string"],
        "status": "string (active/archived)",
        "created_at": "ISODate",
        "updated_at": "ISODate"
      },
      "sharding": {
        "shard_key": "sku",
        "strategy": "Hashed sharding"
      },
      "replication": {
        "replica_set_size": 3,
        "read_preference": "nearest"
      },
      "indexes": [
        {"field": "sku", "type": "unique"},
        {"field": "category_id", "type": "standard"},
        {"field": "name", "type": "text"},
        {"field": "analytics.trending_score", "type": "standard"},
        {"field": "created_at", "type": "standard"}
      ]
    },
    
    "orders": {
      "description": "Commandes shardées par date pour analytics temporels",
      "schema": {
        "_id": "ObjectId",
        "order_number": "string (unique)",
        "shard_date": "string (YYYY-MM, shard key)",
        "user_id": "ObjectId",
        "region": "string",
        "user_snapshot": "object",
        "items": [
          {
            "product_id": "ObjectId",
            "product_snapshot": {
              "sku": "string",
              "name": "string",
              "category": "string",
              "price": "object"
            },
            "quantity": "integer",
            "unit_price": "decimal",
            "subtotal": "decimal"
          }
        ],
        "pricing": {
          "subtotal": "decimal",
          "tax": "decimal",
          "shipping": "decimal",
          "discount": "decimal",
          "total": "decimal",
          "currency": "string"
        },
        "shipping_address": "object",
        "status": "string",
        "payment": "object",
        "tracking": "object",
        "created_at": "ISODate",
        "updated_at": "ISODate",
        "completed_at": "ISODate",
        "status_history": ["object"]
      },
      "sharding": {
        "shard_key": "shard_date",
        "strategy": "Range-based sharding (par mois)",
        "rationale": "Queries analytics souvent par période"
      },
      "replication": {
        "replica_set_size": 5,
        "read_preference": "primaryPreferred",
        "write_concern": "majority"
      },
      "indexes": [
        {"field": "order_number", "type": "unique"},
        {"field": "user_id", "type": "standard"},
        {"field": "status", "type": "standard"},
        {"field": "created_at", "type": "standard"},
        {"field": "region", "type": "standard"},
        {"field": "shard_date", "type": "standard"}
      ]
    },
    
    "analytics_daily": {
      "description": "Collection pré-agrégée pour analytics rapides (NEW)",
      "schema": {
        "_id": "ObjectId",
        "date": "ISODate (shard key)",
        "region": "string",
        "metrics": {
          "total_orders": "integer",
          "total_revenue": "decimal",
          "total_items_sold": "integer",
          "average_order_value": "decimal",
          "unique_customers": "integer",
          "new_customers": "integer"
        },
        "top_products": [
          {
            "product_id": "ObjectId",
            "sku": "string",
            "name": "string",
            "units_sold": "integer",
            "revenue": "decimal"
          }
        ],
        "top_categories": [
          {
            "category_id": "ObjectId",
            "name": "string",
            "units_sold": "integer",
            "revenue": "decimal"
          }
        ],
        "hourly_breakdown": [
          {
            "hour": "integer",
            "orders": "integer",
            "revenue": "decimal"
          }
        ],
        "generated_at": "ISODate"
      },
      "sharding": {
        "shard_key": "date",
        "strategy": "Range-based sharding"
      },
      "replication": {
        "replica_set_size": 3,
        "read_preference": "secondary"
      },
      "indexes": [
        {"field": "date", "type": "standard"},
        {"field": "region", "type": "standard"}
      ],
      "generation": "Batch job nocturne via aggregation pipeline"
    },
    
    "analytics_monthly": {
      "description": "Agrégations mensuelles pour rapports long-terme (NEW)",
      "schema": {
        "_id": "ObjectId",
        "year_month": "string (YYYY-MM)",
        "region": "string",
        "metrics": {
          "total_orders": "integer",
          "total_revenue": "decimal",
          "average_order_value": "decimal",
          "unique_customers": "integer",
          "returning_customers": "integer",
          "customer_retention_rate": "number"
        },
        "product_trends": [
          {
            "product_id": "ObjectId",
            "trend": "string (rising/stable/declining)",
            "percent_change": "number"
          }
        ],
        "generated_at": "ISODate"
      },
      "indexes": [
        {"field": "year_month", "type": "standard"},
        {"field": "region", "type": "standard"}
      ]
    },
    
    "product_views": {
      "description": "Événements de tracking pour analytics temps réel (NEW)",
      "schema": {
        "_id": "ObjectId",
        "product_id": "ObjectId",
        "user_id": "ObjectId (nullable)",
        "session_id": "string",
        "event_type": "string (view/cart_add/purchase)",
        "timestamp": "ISODate",
        "region": "string",
        "metadata": {
          "source": "string",
          "device": "string",
          "duration_seconds": "integer"
        }
      },
      "sharding": {
        "shard_key": "timestamp",
        "strategy": "Range-based (time-series pattern)"
      },
      "ttl_index": {
        "field": "timestamp",
        "expire_after": "90 days"
      },
      "indexes": [
        {"field": "product_id", "type": "standard"},
        {"field": "timestamp", "type": "standard"}
      ]
    }
  },
  
  "refactoring_strategies": {
    "1_sharding": {
      "description": "Distribution horizontale des données",
      "implementation": [
        "Users shardés par région géographique (latence optimale)",
        "Products shardés par SKU (distribution uniforme)",
        "Orders shardés par mois (analytics efficaces)",
        "Zone sharding pour conformité RGPD (données EU en EU)"
      ],
      "benefits": [
        "Scalabilité horizontale illimitée",
        "Réduction de la charge par shard",
        "Queries localisées plus rapides"
      ]
    },
    
    "2_replication": {
      "description": "Haute disponibilité via replica sets",
      "configuration": {
        "topology": "3-5 répliques par shard",
        "distribution": "Multi-datacenter (différentes AZ)",
        "failover": "Automatique (élection primaire en <10s)",
        "backup": "Répliques dédiées pour backups"
      },
      "read_strategies": {
        "users": "secondaryPreferred (décharge le primary)",
        "products": "nearest (latence minimale)",
        "orders": "primaryPreferred (données les plus récentes)",
        "analytics": "secondary (évite impact sur transactions)"
      },
      "benefits": [
        "Zero downtime lors de maintenance",
        "Tolérance aux pannes de datacenters",
        "CAP: Disponibilité > Consistance (configurable)"
      ]
    },
    
    "3_denormalization": {
      "description": "Données pré-agrégées pour analytics",
      "collections_added": [
        "analytics_daily: métriques quotidiennes",
        "analytics_monthly: tendances long-terme",
        "product_views: événements temps réel"
      ],
      "denormalized_fields": [
        "users.total_orders / total_spent (évite COUNT queries)",
        "products.analytics.* (métriques calculées)",
        "products.category_path (évite jointures)",
        "orders.items[].product_snapshot (historique)"
      ],
      "trade_offs": {
        "pros": [
          "Queries analytics 100-1000x plus rapides",
          "Pas de jointures complexes",
          "Dashboards temps réel possibles"
        ],
        "cons": [
          "Duplication de données (+30% stockage)",
          "Synchronisation asynchrone nécessaire",
          "Possible inconsistance temporaire"
        ]
      }
    },
    
    "4_time_series_optimization": {
      "description": "Pattern time-series pour événements haute vélocité",
      "collections": [
        "product_views avec TTL index (90 jours)",
        "Orders shardés par mois"
      ],
      "benefits": [
        "Insertion ultra-rapide",
        "Archivage automatique (TTL)",
        "Queries analytiques efficaces"
      ]
    }
  },
  
  "cap_theorem_considerations": {
    "chosen_model": "AP (Availability + Partition Tolerance)",
    "justification": [
      "E-commerce nécessite haute disponibilité (24/7)",
      "Consistance éventuelle acceptable pour catalogue",
      "Consistance forte configurable pour orders critiques"
    ],
    "implementation": {
      "catalog": "Eventual consistency (readConcern: local)",
      "orders": "Strong consistency (writeConcern: majority, readConcern: majority)",
      "analytics": "Eventual consistency (batch processing acceptable)"
    }
  },
  
  "performance_improvements": {
    "query_performance": {
      "before": "Product search: 200-500ms",
      "after": "Product search: 20-50ms (via Elasticsearch sync + cache)",
      "improvement": "10x plus rapide"
    },
    "analytics_performance": {
      "before": "Sales report (1 mois): 30-60s (scan complet)",
      "after": "Sales report (1 mois): 100-200ms (pré-agrégé)",
      "improvement": "300x plus rapide"
    },
    "write_throughput": {
      "before": "~5K orders/seconde (single node)",
      "after": "~50K orders/seconde (10 shards)",
      "improvement": "10x plus rapide"
    }
  },
  
  "monitoring_and_maintenance": {
    "aggregation_pipelines": [
      "Nightly job: analytics_daily generation",
      "Weekly job: analytics_monthly generation",
      "Real-time: product_views → products.analytics sync"
    ],
    "health_checks": [
      "Replication lag monitoring",
      "Shard balance monitoring",
      "Query performance tracking"
    ]
  }
}
